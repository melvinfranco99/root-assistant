<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Root Assistant"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analiza tu dispositivo y te da el procedimiento de rooteo exacto para tu modelo."
            android:textSize="14sp"
            android:alpha="0.8"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analizar sistema"
            android:textSize="16sp"
            android:paddingVertical="14dp"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoot"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rootear"
            android:textSize="16sp"
            android:paddingVertical="14dp"
            android:layout_marginTop="12dp"
            app:icon="@android:drawable/ic_lock_idle_lock"
            app:iconGravity="textStart" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/txtOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pulsa «Analizar sistema» para empezar."
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rootear es responsabilidad tuya: puede anular la garantía, borrar tus datos y afectar a apps de banca. Úsalo solo en dispositivos de tu propiedad."
            android:textSize="11sp"
            android:alpha="0.6"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
